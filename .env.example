# ─────────────────────────────────────────────────────────────────────────────
# Denah cloud accounts (Supabase). Copy this file to `.env` and fill in values.
# Both are OPTIONAL: if either is missing, Denah runs in GUEST / local-only mode
# (plans are saved in your browser, no sign-in required).
#
# Find these in your Supabase project → Settings → API.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
